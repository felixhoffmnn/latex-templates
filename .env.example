# Directory for invoice data (customer.csv, invoice.csv archive)
#DATA_DIR=./data

# Path to config.yml
#CONFIG_PATH=./config.yml

# Starting invoice number when no archive exists
#LAST_INVOICE=1

# Container runtime for XRechnung validation (podman or docker)
#CONTAINER_RUNTIME=podman

# Open PDF viewer after generation (true/false)
#OPEN_PDF=true

# Open mail client after generation (true/false)
#OPEN_MAIL=true
