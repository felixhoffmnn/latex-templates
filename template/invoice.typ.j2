#import "../../template/base.typ": letter-base
#import "@preview/tiaoma:0.3.0"

#let custom-gray = luma(90%)

#show: letter-base.with(
{% include '_sender.typ.j2' %}
{% include '_recipient.typ.j2' %}
    subject: "Rechnung {{ invoice.invoice_number }}",
    date: [{{ invoice.date }}],
    information-box: (
        [Rechnungsnummer:], [{{ invoice.invoice_number }}],
        [Rechnungsdatum:], [{{ invoice.date }}],
        {% if invoice.start_date and invoice.end_date %}
        [Leistungszeitraum:], [{{ invoice.start_date }} -- {{ invoice.end_date }}],
        {% endif %}
        [Kundennummer:], [{{ customer.customer_id }}],
    ),
)

Sehr geehrte Damen und Herren,

meine Leistungen stelle ich Ihnen wie folgt in Rechnung.

#[
  #set text(size: 10pt)
  #show table.cell.where(y: 0): strong
  #table(
    {% if has_vat %}
    columns: (auto, 1fr, auto, auto, auto, auto, auto),
    align: (center, left, right, left, right, right, right),
    {% else %}
    columns: (auto, 1fr, auto, auto, auto, auto),
    align: (center, left, right, left, right, right),
    {% endif %}
    stroke: 0.75pt,
    inset: 7pt,

    {% if has_vat %}
    table.header([Pos.], [Bezeichnung], [Menge], [Einheit], [Einzel €], [MwSt %], [Netto €]),
    {% else %}
    table.header([Pos.], [Bezeichnung], [Menge], [Einheit], [Einzel €], [Gesamt €]),
    {% endif %}

    {% for item in invoice.items %}
    {% if has_vat %}
    [{{ loop.index }}], [*{{ item.name }}* {% if item.description %} \ #text(10pt)[{{ item.description }}] {% endif %}], [{{ item.quantity }}], [{{ item.unit }}], [{{ item.price | currency }} €], [{{ item.vat_rate }} %], [{{ item.total | currency }} €],
    {% else %}
    [{{ loop.index }}], [*{{ item.name }}* {% if item.description %} \ #text(10pt)[{{ item.description }}] {% endif %}], [{{ item.quantity }}], [{{ item.unit }}], [{{ item.price | currency }} €], [{{ item.total | currency }} €],
    {% endif %}
    {% endfor %}

    {% if has_vat %}
    table.cell(colspan: 6, align: left, [Nettobetrag]),
    [{{ invoice.total | currency }} €],

    {% for rate, group in vat_groups.items() %}
    {% if rate > 0 %}
    table.cell(colspan: 6, align: left, [zzgl. {{ rate }}% MwSt auf {{ group.basis | currency }} €]),
    [{{ group.amount | currency }} €],
    {% else %}
    table.cell(colspan: 6, align: left, [Umsatzsteuerfreie Leistungen (§19 UStG)]),
    [0,00 €],
    {% endif %}
    {% endfor %}

    table.cell(colspan: 6, align: left, fill: custom-gray, [*Gesamtbetrag*]),
    table.cell(fill: custom-gray, [*{{ invoice.total_gross | currency }} €*]),
    {% else %}
    table.footer(
      table.cell(colspan: 5, align: left, fill: custom-gray, [*Gesamtbetrag\**]),
      table.cell(fill: custom-gray, [*{{ invoice.total | currency }} €*]),
    ),
    {% endif %}
  )
  {% if not has_vat %}
  #text(size: 10pt)[\* Umsatzsteuerfreie Leistungen gemäß §19 UStG.]
  {% endif %}
]
#v(1em)

#block(breakable: false)[
Bitte überweisen Sie den Betrag von *{{ display_total | currency }} €* bis zum *{{ invoice.due_date }}* an die folgende Bankverbindung. _Der dargestellte QR-Code kann zur automatischen Übernahme der Daten in Ihr Online-Banking genutzt werden._

#v(1em)
#let billing-details = (
  [#grid(
      columns: (auto, 1fr),
      gutter: 10pt,

      [Kontoinhaber:], [{{ config.sender.address.name }}],
      [Bank:], [{{ config.sender.bank.name }}],
      [IBAN:], [{{ config.sender.bank.iban }}],
      [Betrag:], [{{ display_total | currency }} €],
      [Verwendungszweck:], [{{ additional.purpose }}],
    )]
)

// https://de.wikipedia.org/wiki/EPC-QR-Code
#let invoice-data = "BCD
002
1
SCT

{{ config.sender.address.name }}
{{ config.sender.bank.iban }}
EUR{{ display_total | currency("en") }}


{{ additional.purpose }}"

#grid(
  columns: (3fr, 1fr),
  gutter: 3pt,

  grid.cell(align: left + horizon, billing-details),
  grid.cell(align: right + horizon, [#tiaoma.qrcode(invoice-data)])
)
#v(1em)

Vielen Dank für die gute Zusammenarbeit.
